# ===========================================================================
# Surat News Reel Engine - Environment Configuration
# ===========================================================================

# 1. Google Gemini 2.5 API Key (for Gujarati SOP news script & caption generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash


# 3. Meta Instagram Graph API (v19.0+)
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_long_lived_access_token

# 4. Public Video Hosting (Required for Instagram Graph API video URL ingestion)
# Example Cloudinary URL: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
